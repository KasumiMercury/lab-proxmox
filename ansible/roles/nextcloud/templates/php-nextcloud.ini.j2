; {{ ansible_managed }}
; Same limits as the nextcloud Docker image (PHP_MEMORY_LIMIT / PHP_UPLOAD_LIMIT)
memory_limit = {{ nextcloud_php_memory_limit }}
upload_max_filesize = {{ nextcloud_php_upload_limit }}
post_max_size = {{ nextcloud_php_upload_limit }}
max_execution_time = 3600
max_input_time = 3600
output_buffering = 0

; APCu is the local memcache (config/apcu.config.php); occ and cron.php run on the CLI
apc.enable_cli = 1

opcache.enable = 1
opcache.interned_strings_buffer = 32
opcache.max_accelerated_files = 10000
opcache.memory_consumption = 128
opcache.save_comments = 1
opcache.revalidate_freq = 60
opcache.jit = 1255
opcache.jit_buffer_size = 8M
