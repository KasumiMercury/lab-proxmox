; {{ ansible_managed }}
[www]
user = www-data
group = www-data

listen = /run/php/php{{ nextcloud_php_version }}-fpm.sock
listen.owner = www-data
listen.group = www-data

pm = dynamic
pm.max_children = 12
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
pm.max_requests = 500

; Nextcloud warns when getenv("PATH") is empty
env[PATH] = /usr/local/bin:/usr/bin:/bin
