# {{ ansible_managed }}
[OPTIONS]

enable: 1
policy_in: DROP
policy_out: ACCEPT

[IPSET management] # GUI/API, SSH and consoles (rules generated by PVE)

{% for e in pve_firewall_management %}
{{ e.cidr }} # {{ e.comment }}
{% endfor %}

[IPSET ceph_clients] # Ceph mon/OSD/mgr

{% for e in pve_firewall_ceph_clients %}
{{ e.cidr }} # {{ e.comment }}
{% endfor %}

[RULES]

IN Ceph(ACCEPT) -source +dc/ceph_clients -log nolog # mon 3300/6789, OSD/mgr 6800-7300
IN ACCEPT -p udp -dport 41641 -log nolog # Tailscale direct connections
IN Ping(ACCEPT) -source +dc/management -log nolog
