# Managed by Ansible (role monitoring_server)
# Each rule is an instant query (A) and a threshold on it (B): PromQL on VictoriaMetrics, or a LogsQL
# stats query on VictoriaLogs (datasource victorialogs). The VictoriaLogs plugin clips the query to
# the rule's time range, so a LogsQL _time filter longer than 10 minutes needs a matching range.
# Queries that return nothing while all is well (No data) count as normal. Annotations use
# .Labels / .Values: a "$" would be taken for an environment variable by the provisioning.
# pve-auth-failures matches the messages as logged on PVE 9 / trixie. pvedaemon checks the GUI/API
# logins (IPCC.xs logs the same failure again via PAM, not counted); pveproxy's "401 ... invalid PVE
# ticket" is an expired session. Only key logins are allowed and sshd logs at INFO, so a rejected key
# shows up as the client giving up ("authenticating user"), not as "Failed publickey". One line per
# failed connection.
{%- set rules = [
  {
    'uid': 'pve-node-offline', 'title': 'Proxmox node offline', 'severity': 'critical', 'for': '2m',
    'expr': 'min by (id) (pve_up{job="pve", id=~"node/.*"})',
    'evaluator': {'type': 'lt', 'params': [1]},
    'summary': 'Proxmox node {{ .Labels.id }} is offline in the cluster',
  },
  {
    'uid': 'pve-metrics-missing', 'title': 'Metrics missing from a Proxmox node', 'severity': 'critical', 'for': '1m',
    'expr': 'group by (instance) (last_over_time(up{job="vmagent"}[1d])) unless group by (instance) (last_over_time(up{job="vmagent"}[5m]))',
    'evaluator': {'type': 'gt', 'params': [0]},
    'summary': 'No metrics from {{ .Labels.instance }} for 5 minutes (node down or vmagent not pushing)',
  },
  {
    'uid': 'pve-scrape-failed', 'title': 'Exporter down on a Proxmox node', 'severity': 'warning', 'for': '5m',
    'expr': 'up{job=~"node|pve|ceph"}',
    'evaluator': {'type': 'lt', 'params': [1]},
    'summary': 'vmagent on {{ or .Labels.node .Labels.instance }} cannot scrape {{ .Labels.job }}',
  },
  {
    'uid': 'pve-guest-down', 'title': 'Guest not running', 'severity': 'critical', 'for': '5m',
    'expr': 'max by (id, name) (pve_up{id=~"(qemu|lxc)/.*"} * on (id, instance) group_left (name) pve_guest_info{template="0", name=~"' ~ grafana_alert_running_guests ~ '"})',
    'evaluator': {'type': 'lt', 'params': [1]},
    'summary': '{{ .Labels.name }} ({{ .Labels.id }}) is not running',
  },
  {
    'uid': 'pve-storage-usage', 'title': 'Proxmox storage almost full', 'severity': 'warning', 'for': '15m',
    'expr': 'max by (id) (pve_disk_usage_bytes{id=~"storage/.*"} / pve_disk_size_bytes{id=~"storage/.*"})',
    'evaluator': {'type': 'gt', 'params': [grafana_alert_storage_usage]},
    'summary': '{{ .Labels.id }} is {{ humanizePercentage .Values.A.Value }} full',
  },
  {
    'uid': 'pve-memory-low', 'title': 'Proxmox node low on memory', 'severity': 'warning', 'for': '5m',
    'expr': 'node_memory_MemAvailable_bytes{job="node"}',
    'evaluator': {'type': 'lt', 'params': [grafana_alert_memory_available]},
    'summary': '{{ .Labels.instance }} has only {{ humanize1024 .Values.A.Value }}B of memory available',
  },
  {
    'uid': 'pve-swap-in', 'title': 'Proxmox node swapping in', 'severity': 'warning', 'for': '10m',
    'expr': 'rate(node_vmstat_pswpin{job="node"}[5m])',
    'evaluator': {'type': 'gt', 'params': [grafana_alert_swap_in_pages]},
    'summary': '{{ .Labels.instance }} reads {{ humanize .Values.A.Value }} pages/s back from swap: guests or Ceph are being slowed down',
  },
  {
    'uid': 'ceph-health-warn', 'title': 'Ceph HEALTH_WARN', 'severity': 'warning', 'for': '5m',
    'expr': 'ceph_health_status',
    'evaluator': {'type': 'within_range', 'params': [0.5, 1.5]},
    'summary': 'Ceph reports HEALTH_WARN (ceph health detail)',
  },
  {
    'uid': 'ceph-health-err', 'title': 'Ceph HEALTH_ERR', 'severity': 'critical', 'for': '1m',
    'expr': 'ceph_health_status',
    'evaluator': {'type': 'gt', 'params': [1.5]},
    'summary': 'Ceph reports HEALTH_ERR (ceph health detail)',
  },
  {
    'uid': 'ceph-osd-down', 'title': 'Ceph OSD down', 'severity': 'critical', 'for': '5m',
    'expr': 'ceph_osd_up',
    'evaluator': {'type': 'lt', 'params': [1]},
    'summary': '{{ .Labels.ceph_daemon }} is down',
  },
  {
    'uid': 'ceph-pool-usage', 'title': 'Ceph pool almost full', 'severity': 'warning', 'for': '15m',
    'expr': 'ceph_pool_percent_used * on (pool_id) group_left (name) ceph_pool_metadata',
    'evaluator': {'type': 'gt', 'params': [grafana_alert_ceph_pool_usage]},
    'summary': 'Ceph pool {{ .Labels.name }} is {{ humanizePercentage .Values.A.Value }} full',
  },
  {
    'uid': 'ceph-metrics-missing', 'title': 'Ceph metrics missing', 'severity': 'critical', 'for': '1m',
    'expr': 'absent_over_time(ceph_health_status[10m])',
    'evaluator': {'type': 'gt', 'params': [0]},
    'summary': 'No Ceph metrics for 10 minutes (no active mgr, or its prometheus module is off)',
  },
  {
    'uid': 'pve-auth-failures', 'title': 'Failed logins on a Proxmox node', 'severity': 'warning', 'for': '0s',
    'datasource': 'victorialogs',
    'expr': '_time:5m ('
      ~ '(SYSLOG_IDENTIFIER:in(pvedaemon, pveproxy) "authentication failure; rhost=")'
      ~ ' OR (SYSLOG_IDENTIFIER:in(sshd, sshd-session) ("Invalid user" OR "closed by authenticating user"'
      ~ ' OR "Disconnected from authenticating user" OR "maximum authentication attempts exceeded"))'
      ~ ') | rename _HOSTNAME as host, SYSLOG_IDENTIFIER as source | stats by (host, source) count() as failures',
    'evaluator': {'type': 'gt', 'params': [grafana_alert_auth_failures - 1]},
    'summary': '{{ .Values.A.Value }} failed logins to {{ .Labels.source }} on {{ .Labels.host }} in 5 minutes',
  },
  {
    'uid': 'pve-logs-missing', 'title': 'Logs missing from a Proxmox node', 'severity': 'critical', 'for': '1m',
    'datasource': 'victorialogs', 'range': 86400,
    'expr': '_time:1d | rename _HOSTNAME as host | stats by (host) count() if (_time:10m) as recent',
    'evaluator': {'type': 'lt', 'params': [1]},
    'summary': 'No journal entries from {{ .Labels.host }} for 10 minutes (systemd-journal-upload not sending)',
  },
] %}

apiVersion: 1
groups:
  - orgId: 1
    name: Proxmox
    folder: Proxmox
    interval: 1m
    rules:
{% for rule in rules %}
      - uid: {{ rule.uid }}
        title: {{ rule.title | to_json }}
        condition: B
        data:
          - refId: A
            relativeTimeRange: { from: {{ rule.range | default(600) }}, to: 0 }
            datasourceUid: {{ rule.datasource | default('victoriametrics') }}
            model:
              refId: A
              expr: {{ rule.expr | to_json }}
{% if rule.datasource | default('victoriametrics') == 'victorialogs' %}
              queryType: stats
{% else %}
              instant: true
              range: false
{% endif %}
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: threshold
              expression: A
              conditions:
                - evaluator: {{ rule.evaluator | to_json }}
        noDataState: OK
        execErrState: Error
        for: {{ rule.for }}
        labels:
          severity: {{ rule.severity }}
        annotations:
          summary: {{ rule.summary | to_json }}
{% endfor %}
