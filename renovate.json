{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "git-submodules": {
    "enabled": true
  },
  "customDatasources": {
    "grafana-dashboards": {
      "description": "Revisions of a grafana.com dashboard (packageName = dashboard ID)",
      "defaultRegistryUrlTemplate": "https://grafana.com/api/dashboards/{{packageName}}/revisions",
      "transformTemplates": [
        "{\"releases\": [items.{\"version\": $string(revision), \"releaseTimestamp\": createdAt}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions annotated with a '# renovate:' comment on the line above (Ansible role defaults)",
      "managerFilePatterns": [
        "/^ansible/roles/[^/]+/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( registryUrl=(?<registryUrl>\\S+))?\\n\\s*[A-Za-z0-9_]+:\\s*[\"']?(?<currentValue>[^\\s\"']+)"
      ]
    },
    {
      "customType": "regex",
      "description": "grafana.com dashboards provisioned on strix (grafana_dashboards)",
      "managerFilePatterns": [
        "/^ansible/roles/monitoring_server/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "\\{ id: (?<packageName>\\d+), revision: (?<currentValue>\\d+), file: (?<depName>[^,\\s}]+)"
      ],
      "datasourceTemplate": "custom.grafana-dashboards",
      "versioningTemplate": "regex:^(?<major>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "vmagent on the Proxmox nodes and VictoriaMetrics on strix move together",
      "matchPackageNames": [
        "victoriametrics/victoria-metrics",
        "VictoriaMetrics/VictoriaMetrics"
      ],
      "groupName": "VictoriaMetrics"
    },
    {
      "description": "tflint in mise.toml (local, lefthook) and in the plan workflow (setup-tflint) move together",
      "matchPackageNames": [
        "terraform-linters/tflint"
      ],
      "groupName": "tflint"
    },
    {
      "description": "Name dashboard PRs after the provisioned file and the grafana.com ID",
      "matchDatasources": [
        "custom.grafana-dashboards"
      ],
      "commitMessageTopic": "Grafana dashboard {{depName}} ({{packageName}})"
    }
  ]
}
