# Terraform local state and caches
.terraform/
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan

# Decrypted secrets (commit only the sops-encrypted *.sops.json)
*.tfvars.json

# Ansible generated inventory and cache
ansible/inventory/*.ini
.ansible/

# Env files (local only)
.env

.vault_pass.txt

# Ansible artifacts fetched from hosts (kubeconfig etc.)
ansible/artifacts/*
!ansible/artifacts/.keep

# Local-only notes (may contain sensitive details)
/docs/
